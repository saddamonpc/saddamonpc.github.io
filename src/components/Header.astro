---
import { NAV_LINKS, type NavKey, SITE_TITLE } from '../consts';

interface Props {
	current?: NavKey;
}

const { current } = Astro.props;
---

<header class="border-b border-line">
	<div data-header-inner class="mx-auto flex max-w-5xl flex-wrap items-baseline gap-x-6 gap-y-2 px-4 py-3 sm:px-8">
		<a href="/" class="font-serif text-lg font-semibold text-strong no-underline">{SITE_TITLE}</a>
		<button
			type="button"
			class="menu-button ml-auto cursor-pointer rounded border border-line px-2.5 py-0.5 font-mono text-sm text-fg aria-expanded:border-accent aria-expanded:text-accent"
			aria-expanded="false"
			aria-controls="main-nav">☰ menu</button
		>
		<nav id="main-nav" aria-label="Main" class="ml-auto font-mono text-sm">
			<ul class="flex flex-wrap justify-end gap-x-2">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={current === link.key ? 'page' : undefined}
								class="block px-1 text-fg no-underline hover:bg-accent hover:text-bg aria-[current=page]:bg-accent aria-[current=page]:text-bg"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	/* The burger only exists on phones, and only when JavaScript is on. */
	.menu-button {
		display: none;
	}
	@media (max-width: 639px) {
		:global(.js) .menu-button {
			display: inline-block;
		}
		:global(.js) #main-nav {
			width: 100%;
		}
		:global(.js) #main-nav:not(.open) {
			display: none;
		}
		:global(.js) #main-nav ul {
			flex-direction: column;
		}
		:global(.js) #main-nav a {
			padding: 0.5rem 0.25rem;
			border-bottom: 1px solid var(--color-line);
		}
	}
</style>

<script>
	const button = document.querySelector<HTMLButtonElement>('.menu-button')!;
	const nav = document.getElementById('main-nav')!;

	function setOpen(open: boolean) {
		nav.classList.toggle('open', open);
		button.setAttribute('aria-expanded', String(open));
		button.textContent = open ? '✕ close' : '☰ menu';
	}

	button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
			setOpen(false);
			button.focus();
		}
	});
</script>
