---
// One job or study entry: "Role at Organisation" with dates on the right, location, then details.
// The dot on the timeline is filled while the entry is ongoing (end: 'present').
import type { CvEntry } from '../data/cv';

interface Props {
	entry: CvEntry;
}

const { entry } = Astro.props;
---

<div data-cv-entry class:list={['entry relative mb-4', { ongoing: entry.end === 'present' }]}>
	<div class="flex flex-wrap items-baseline justify-between gap-x-3">
		<span data-cv-title><b class="font-semibold text-strong">{entry.title}</b> at {entry.org}</span>
		<span data-cv-when class="text-sm whitespace-nowrap text-muted">{entry.start} – {entry.end}</span>
	</div>
	{entry.location && <div class="text-sm text-muted">{entry.location}</div>}
	{entry.note && <p class="mt-1 text-[0.95em]">{entry.note}</p>}
	{
		entry.bullets && (
			<ul class="mt-1 list-disc pl-5">
				{entry.bullets.map((bullet) => (
					<li>{bullet}</li>
				))}
			</ul>
		)
	}
</div>

<style>
	/* The timeline dot, sitting on the rail drawn by the section (see cv.astro). */
	.entry::before {
		content: '';
		position: absolute;
		left: calc(-1.25rem - 6px); /* centres the 11px dot on the 1px line drawn by the section */
		top: 0.45rem;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		/* A gradient ring: page colour inside, pistachio-to-mint showing through the transparent border. */
		border: 2px solid transparent;
		background:
			linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
			linear-gradient(90deg, var(--color-accent), var(--color-mint)) border-box;
	}
	/* Ongoing: filled with the gradient. */
	.entry.ongoing::before {
		background: linear-gradient(90deg, var(--color-accent), var(--color-mint)) border-box;
	}
</style>
