---
// A row of #tag links. Each one opens the posts (or projects) page filtered to that tag.
import { type CollectionName, tagUrl } from '../lib/content';

interface Props {
	tags: string[];
	collection: CollectionName;
}

const { tags, collection } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="inline-flex flex-wrap gap-1">
			{tags.map((tag) => (
				<li>
					<a href={tagUrl(collection, tag)} class="tag-pill rounded-full px-2 py-px text-sm text-note italic no-underline">
						#{tag}
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	/* Lavender fading into mint, a little stronger on hover. */
	.tag-pill {
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--color-note) 16%, transparent),
			color-mix(in srgb, var(--color-mint) 16%, transparent)
		);
	}
	.tag-pill:hover {
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--color-note) 30%, transparent),
			color-mix(in srgb, var(--color-mint) 30%, transparent)
		);
	}
</style>
