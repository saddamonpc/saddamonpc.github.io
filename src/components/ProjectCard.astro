---
// One card on the projects page: cover picture, title, year, tags.
// The picture and title are one link; the tags are separate links after it (links can't be nested).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { entryUrl } from '../lib/content';
import { formatDate } from '../lib/dates';
import TagPills from './TagPills.astro';

interface Props {
	id: string;
	title: string;
	date: Date;
	tags: string[];
	cover?: ImageMetadata;
}

const { id, title, date, tags, cover } = Astro.props;
---

<article data-tags={JSON.stringify(tags)} class="overflow-hidden rounded-md border border-line hover:border-accent">
	<a href={entryUrl('projects', id)} class="block text-fg no-underline">
		{
			cover ? (
				<Image src={cover} alt="" width={480} class="aspect-[4/3] w-full object-cover" />
			) : (
				<div class="flex aspect-[4/3] w-full items-center justify-center bg-code p-4 text-center font-mono text-sm text-muted">{title}</div>
			)
		}
		<div class="px-3 pt-2">
			<b class="block leading-snug font-semibold text-strong">{title}</b>
			<span class="text-sm text-muted">{formatDate(date, 'year')}</span>
		</div>
	</a>
	<div class="px-3 pt-1 pb-3">
		<TagPills tags={tags} collection="projects" />
	</div>
</article>
