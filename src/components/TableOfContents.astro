---
// "On this page" list of a post's headings.
// Wide screens: a sticky sidebar that highlights the section being read.
// Phones (and without JavaScript): a folded "contents" box under the title.
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');

// Each entry's place on the pistachio-to-mint scale: 0% for the first, 100% for the last, evenly spread between.
const mix = (i: number) => (items.length > 1 ? Math.round((i / (items.length - 1)) * 100) : 0);
---

{
	items.length >= 2 && (
		<details class="toc rounded border border-line px-3 py-2 lg:border-0 lg:p-0" data-toc>
			<summary class="cursor-pointer font-semibold text-strong">Contents</summary>
			<p class="toc-label mb-2 font-semibold text-strong">Contents</p>
			<nav aria-label="Table of contents">
				<ol class="mt-2 flex flex-col gap-1 font-mono text-sm leading-snug lg:mt-0">
					{items.map((h, i) => (
						<li class={h.depth === 3 ? 'pl-3' : ''}>
							<a href={`#${h.slug}`} class="toc-link block py-1 pl-2.5 text-muted no-underline" style={`--mix: ${mix(i)}%`}>
								{h.text}
							</a>
						</li>
					))}
				</ol>
			</nav>
		</details>
	)
}

<style>
	.toc-label {
		display: none;
	}
	.toc[data-wide] summary {
		display: none;
	}
	.toc[data-wide] .toc-label {
		display: block;
	}

	/*
	  The whole list runs from pistachio (first entry) to mint (last): each entry has its own colour
	  on that scale (--mix, set above). Each glows faintly in it, like a quote; the section being read
	  lights up brightly in it.
	*/
	.toc-link {
		--toc-color: color-mix(in srgb, var(--color-accent), var(--color-mint) var(--mix, 0%));
		border-left: 2px solid var(--color-line);
		background: linear-gradient(90deg, color-mix(in srgb, var(--toc-color) 7%, transparent), transparent 85%);
	}
	.toc-link:hover {
		color: var(--color-fg);
		background: linear-gradient(90deg, color-mix(in srgb, var(--toc-color) 12%, transparent), transparent 85%);
	}
	.toc-link[aria-current='true'] {
		color: var(--toc-color);
		border-left-color: var(--toc-color);
		background: linear-gradient(90deg, color-mix(in srgb, var(--toc-color) 18%, transparent), transparent 85%);
	}
</style>

<script>
	const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
	if (toc) {
		// Open as a sidebar on wide screens, folded on phones.
		const wide = matchMedia('(min-width: 1024px)');
		const sync = () => {
			toc.open = wide.matches;
			toc.toggleAttribute('data-wide', wide.matches);
		};
		sync();
		wide.addEventListener('change', sync);

		// Highlight the link of the section currently at the top of the screen.
		const links = [...toc.querySelectorAll('a')];
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					for (const link of links) link.setAttribute('aria-current', String(link.hash === `#${entry.target.id}`));
				}
			},
			{ rootMargin: '0px 0px -70% 0px' },
		);
		for (const link of links) {
			const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
			if (heading) observer.observe(heading);
		}
	}
</script>
