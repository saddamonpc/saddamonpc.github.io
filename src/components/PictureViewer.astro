---
// Full-size viewer for the picture strips, using the PhotoSwipe library.
// PhotoSwipe handles ← → to flip, Esc to close, swiping on phones, and putting focus back where it was.
// Its video plugin plays video files (and pauses them when you flip away); YouTube videos get YouTube's player.
---

<script>
	import PhotoSwipeLightbox from 'photoswipe/lightbox';
	import PhotoSwipeVideoPlugin from 'photoswipe-video-plugin';
	import 'photoswipe/style.css';
	import type { StripItem } from '../lib/images';

	type Strip = { title: string; url: string; media: StripItem[] };
	let current: Strip | undefined;

	// The video plugin waits for a poster picture before showing a video. There is none, so give it an empty one.
	const NO_POSTER = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
	const ROOM_FOR_BARS = 100; // keeps a video's controls clear of the top bar and the caption

	const lightbox = new PhotoSwipeLightbox({
		pswpModule: () => import('photoswipe'),
		bgOpacity: 0.92,
		showHideAnimationType: 'fade',
	});
	new PhotoSwipeVideoPlugin(lightbox, {});

	// Flipping away from a YouTube video stops it (reloading its player is the only way without YouTube's own script).
	lightbox.on('contentDeactivate', ({ content }) => {
		const player = content.element?.querySelector('iframe');
		if (player) player.src = player.src;
	});

	function slide(item: StripItem) {
		if (item.kind === 'image') return { src: item.full, width: item.width, height: item.height, alt: item.caption };
		if (item.kind === 'video') {
			// Fill the screen: the video keeps its own shape inside, whether it was filmed upright or sideways.
			return { type: 'video', videoSrc: item.full, msrc: NO_POSTER, width: innerWidth, height: innerHeight - ROOM_FOR_BARS };
		}
		const title = item.caption.replaceAll('&', '&amp;').replaceAll('"', '&quot;');
		return { html: `<div class="pswp-youtube"><iframe src="${item.full}" title="${title}" allowfullscreen></iframe></div>` };
	}

	lightbox.on('uiRegister', () => {
		// The caption and which post it's from, under the picture
		lightbox.pswp?.ui?.registerElement({
			name: 'caption',
			order: 9,
			isButton: false,
			appendTo: 'root',
			onInit: (el, pswp) => {
				el.className = 'pswp-caption';
				pswp.on('change', () => {
					const item = current?.media[pswp.currIndex];
					el.textContent = item ? `${item.caption}, from “${current?.title}”` : '';
				});
			},
		});
		// "Open the post ->" link
		lightbox.pswp?.ui?.registerElement({
			name: 'open-post',
			order: 8,
			isButton: false,
			tagName: 'a',
			appendTo: 'bar',
			onInit: (el) => {
				el.className = 'pswp-open-post';
				el.textContent = 'Open the post ->';
				el.setAttribute('href', current?.url ?? '/posts/');
			},
		});
	});
	lightbox.init();

	document.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLElement>('[data-strip] [data-index]');
		if (!button) return;
		current = JSON.parse(button.closest<HTMLElement>('[data-strip]')!.dataset.strip!) as Strip;
		lightbox.loadAndOpen(Number(button.dataset.index), current.media.map(slide));
	});
</script>

<style is:global>
	.pswp-caption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 0.75rem 1rem;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-muted);
		background: #101211cc;
	}
	.pswp-open-post {
		align-self: center;
		margin-right: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-accent);
	}
	.pswp__counter {
		font-family: var(--font-mono);
	}
	/* Tailwind's "max-width: 100%" on videos would squash them to nothing inside PhotoSwipe's zero-width wrapper. */
	.pswp video {
		max-width: none;
	}
	/* A YouTube player as big as fits between the top bar and the caption, in its 16:9 shape. */
	.pswp-youtube {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
	}
	.pswp-youtube iframe {
		width: min(100%, calc((100vh - 100px) * 16 / 9));
		aspect-ratio: 16 / 9;
		border: 0;
		background: #000;
	}
</style>
