---
// A row of tiny thumbnails of a post's pictures and videos, under its title on the posts page.
// Hover (or keyboard focus) shows a bigger preview; a video file plays there, silently.
// Click / Enter / tap opens the viewer (PictureViewer). Videos get a small play badge.
import type { StripItem } from '../lib/images';

interface Props {
	media: StripItem[];
	postTitle: string;
	postUrl: string;
}

const MAX_THUMBS = 6;
const { media, postTitle, postUrl } = Astro.props;
const strip = JSON.stringify({ title: postTitle, url: postUrl, media });
---

{
	media.length > 0 && (
		<div class="thumbs mt-1.5 flex flex-wrap items-center gap-1.5" data-strip={strip}>
			{media.slice(0, MAX_THUMBS).map((item, i) => (
				<button
					type="button"
					class="thumb"
					data-index={i}
					data-kind={item.kind}
					aria-label={`${item.kind === 'image' ? 'View picture' : 'Play video'} ${i + 1} of ${media.length}: ${item.caption}`}
				>
					{item.kind === 'video' ? (
						<video src={`${item.thumb}#t=0.1`} muted playsinline preload="metadata" />
					) : (
						<img src={item.thumb} alt="" loading="lazy" decoding="async" />
					)}
					{item.kind !== 'image' && <span class="play" />}
					<span class="pop">
						{item.kind === 'video' ? (
							<video src={`${item.preview}#t=0.1`} muted loop playsinline preload="none" />
						) : (
							<img src={item.preview} alt="" loading="lazy" decoding="async" />
						)}
						{item.kind === 'youtube' && <span class="play" />}
					</span>
				</button>
			))}
			{media.length > MAX_THUMBS && (
				<button type="button" class="more" data-index={MAX_THUMBS} aria-label={`View ${media.length - MAX_THUMBS} more pictures and videos`}>
					+{media.length - MAX_THUMBS}
				</button>
			)}
		</div>
	)
}

<script>
	// Hovering (or focusing) a video's thumbnail plays it silently in the bigger preview, like YouTube's home page.
	// With "reduce motion" turned on, the preview shows a still frame instead.
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
	for (const thumb of document.querySelectorAll<HTMLElement>('.thumb[data-kind="video"]')) {
		const video = thumb.querySelector<HTMLVideoElement>('.pop video')!;
		const start = () => {
			if (reduceMotion.matches) video.preload = 'metadata'; // loads the first frame
			else video.play().catch(() => {}); // fails harmlessly if stopped again before it started
		};
		const stop = () => video.pause();
		thumb.addEventListener('mouseenter', start);
		thumb.addEventListener('focus', start);
		thumb.addEventListener('mouseleave', stop);
		thumb.addEventListener('blur', stop);
	}
</script>

<style>
	.thumb {
		position: relative;
		padding: 0;
		line-height: 0;
		cursor: zoom-in;
		border: 1px solid var(--color-line);
		border-radius: 3px;
	}
	.thumb:not([data-kind='image']) {
		cursor: pointer;
	}
	.thumb:hover {
		border-color: var(--color-accent);
	}
	.thumb > img,
	.thumb > video {
		width: 44px;
		height: 30px;
		object-fit: cover;
		border-radius: 2px;
	}
	/* Play badge: a white triangle in a dark circle, in the middle of a video's thumbnail. */
	.play {
		position: absolute;
		inset: 0;
		width: 16px;
		height: 16px;
		margin: auto;
		border-radius: 50%;
		background: #000a;
		pointer-events: none;
	}
	.play::after {
		content: '';
		position: absolute;
		inset: 28% 22% 28% 36%;
		background: #fff;
		clip-path: polygon(0 0, 100% 50%, 0 100%);
	}
	.pop .play {
		width: 48px;
		height: 48px;
	}
	.more {
		height: 32px;
		padding: 0 0.5rem;
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-muted);
		border: 1px dashed var(--color-line);
		border-radius: 3px;
	}
	/* Bigger preview: only where there is a mouse to hover with. */
	.pop {
		display: none;
		position: absolute;
		z-index: 10;
		left: 50%;
		bottom: calc(100% + 8px);
		transform: translateX(-50%);
		padding: 4px;
		background: var(--color-bg);
		border: 1px solid var(--color-accent);
		border-radius: 6px;
		box-shadow: 0 8px 24px #000a;
		pointer-events: none;
	}
	.pop img,
	.pop video {
		width: 260px;
		max-width: none;
		height: auto;
		border-radius: 3px;
	}
	.pop video {
		aspect-ratio: 16 / 9;
		background: #000;
	}
	@media (hover: hover) {
		.thumb:hover .pop,
		.thumb:focus-visible .pop {
			display: block;
		}
	}
	/* Bigger targets for fingers. */
	@media (hover: none) {
		.thumb > img,
		.thumb > video {
			width: 52px;
			height: 38px;
		}
		.more {
			height: 40px;
		}
	}
</style>
