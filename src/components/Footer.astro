---
import { FULL_NAME, SOCIALS } from '../consts';

// The build date, in UTC, so it doesn't depend on which computer builds the site.
const built = new Date();
const year = built.getUTCFullYear();
const updated = built.toISOString().slice(0, 10);

const links = [
	{ label: 'email', href: SOCIALS.email },
	{ label: 'github', href: SOCIALS.github },
	{ label: 'linkedin', href: SOCIALS.linkedin },
	{ label: 'rss', href: '/rss.xml' },
];
---

<footer class="mt-16 border-t border-dashed border-line">
	<div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-x-6 gap-y-2 px-4 py-4 font-mono text-xs text-muted sm:px-8">
		<nav aria-label="Elsewhere">
			<ul class="flex flex-wrap gap-x-4">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="text-muted no-underline hover:text-accent hover:underline">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p>© {year} {FULL_NAME} · last updated {updated}</p>
	</div>
</footer>
