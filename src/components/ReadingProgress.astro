---
// A thin bar along the top of the screen showing how far through the text you are.
// It's split into chapters, like story bars: one rounded segment per section of the text (the opening
// text, then one per ## heading), each as wide as its section is long. Sections you've read are full,
// the one you're in fills smoothly with a soft leading edge, and the rest show as a faint track.
// The pistachio-to-mint gradient runs across the whole bar.
// Behind it, a shade in the page colour fades downwards, so text scrolls under it instead of showing through.
// It starts once the text itself reaches the top of the screen, so it never sits over the cover
// picture, and on phones it sits just under the top bar (which stays on screen there).
// Without JavaScript it simply doesn't appear.
---

<div class="reading-progress" data-reading-progress aria-hidden="true">
	<div class="chapters"></div>
</div>

<style>
	/* The strip: placed at the top, the shade behind the chapters, and shown or hidden as a whole. */
	.reading-progress {
		position: fixed;
		top: 0; /* moved under the top bar by the script on phones */
		left: 0;
		right: 0;
		z-index: 30;
		height: 1.75rem;
		background: linear-gradient(to bottom, var(--color-bg), transparent);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	.reading-progress.visible {
		opacity: 1;
	}

	.chapters {
		display: flex;
		gap: 4px;
		height: 3px;
	}
	/* One section: the faint track... */
	.reading-progress :global(.chapter) {
		min-width: 6px;
		overflow: hidden;
		border-radius: 1.5px;
		background: var(--color-line);
	}
	/* ...and how much of it you've read. The gradient spans the whole bar, not each chapter. */
	.reading-progress :global(.fill) {
		height: 100%;
		border-radius: 1.5px;
		background: linear-gradient(to right, var(--color-accent), var(--color-mint)) no-repeat;
		background-size: var(--whole) 100%;
		background-position: calc(-1 * var(--left)) 0;
	}
	/* The section you're in fades out over its last 56px, so the leading edge is soft. */
	.reading-progress :global(.fill.current) {
		mask-image: linear-gradient(to right, #000 calc(100% - 56px), rgb(0 0 0 / 0.25));
	}
</style>

<script>
	const strip = document.querySelector<HTMLElement>('[data-reading-progress]');
	const row = strip?.querySelector<HTMLElement>('.chapters');
	const text = document.querySelector<HTMLElement>('.prose');
	const header = document.querySelector<HTMLElement>('body > header');
	if (strip && row && text) {
		// Where each section starts: the opening text (if the text doesn't begin with a heading), then each ## heading.
		const headings = [...text.querySelectorAll<HTMLElement>(':scope > h2')];
		const starts: (HTMLElement | null)[] = text.firstElementChild?.tagName === 'H2' ? headings : [null, ...headings];
		const chapters = starts.map(() => {
			const chapter = document.createElement('div');
			chapter.className = 'chapter';
			chapter.append(Object.assign(document.createElement('div'), { className: 'fill' }));
			row.append(chapter);
			return chapter;
		});

		const update = () => {
			// Sit under the top bar while it's on screen (phones keep it there; wide screens scroll it away).
			strip.style.top = `${Math.max(0, header?.getBoundingClientRect().bottom ?? 0)}px`;

			// 0 while the text's top is still below the top of the screen, 1 once its end is on screen.
			const box = text.getBoundingClientRect();
			const scrollable = box.height - innerHeight;
			const progress = scrollable > 0 ? Math.min(1, Math.max(0, -box.top / scrollable)) : 0;
			strip.style.setProperty('--progress', String(progress));
			strip.classList.toggle('visible', progress > 0);

			// Each section's place in the text (measured every time: pictures loading can change it).
			const tops = starts.map((heading) => (heading ? heading.getBoundingClientRect().top - box.top : 0));
			const reading = progress * box.height; // how far into the text you are
			chapters.forEach((chapter, i) => {
				const length = (tops[i + 1] ?? box.height) - tops[i];
				const read = Math.min(1, Math.max(0, (reading - tops[i]) / length));
				chapter.style.flexGrow = String(Math.max(1, length));
				const fill = chapter.firstElementChild as HTMLElement;
				fill.style.width = `${read * 100}%`;
				fill.classList.toggle('current', read > 0 && read < 1);
			});
			// Line the gradient up across the whole bar.
			for (const chapter of chapters) {
				const fill = chapter.firstElementChild as HTMLElement;
				fill.style.setProperty('--whole', `${row.clientWidth}px`);
				fill.style.setProperty('--left', `${chapter.offsetLeft}px`);
			}
		};

		// Update at most once per frame while scrolling.
		let queued = false;
		const onScroll = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				update();
			});
		};
		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', onScroll);
		update();
	}
</script>
