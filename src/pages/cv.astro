---
// The CV page: /cv/ — all content comes from src/data/cv.ts.
import CvEntry from '../components/CvEntry.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { cv } from '../data/cv';
import BaseLayout from '../layouts/BaseLayout.astro';

const sectionTitle = 'mt-8 mb-3 border-b border-line pb-1 text-xl font-semibold text-strong';
// The timeline rail: a thin line along the left of each section's entries.
const rail = 'ml-1.5 border-l border-line pl-5';
---

<BaseLayout title="CV / résumé" current="cv">
	<div class="mx-auto max-w-3xl px-4 py-8 sm:px-8">
		<div class="flex flex-wrap items-start justify-between gap-5">
			<div>
				<h1 class="mb-1 text-3xl leading-tight font-semibold text-strong">{cv.name}</h1>
				<p class="mb-2">{cv.role}</p>
				<p class="flex flex-wrap gap-x-4 font-mono text-xs">
					{cv.links.map((link) => <a href={link.href} class="no-underline hover:underline">{link.label}</a>)}
				</p>
			</div>
			<div class="flex flex-col gap-2">
				<DownloadButton label="Download CV" href={cv.pdf.cv} />
				<DownloadButton label="Download résumé" href={cv.pdf.resume} />
			</div>
		</div>
		<p class="mt-2 font-mono text-xs text-muted">last updated {cv.updated}</p>

		<h2 class={sectionTitle}>About</h2>
		<p>{cv.about}</p>

		<h2 class={sectionTitle}>Experience</h2>
		<div class={rail}>{cv.experience.map((entry) => <CvEntry entry={entry} />)}</div>

		<h2 class={sectionTitle}>Education</h2>
		<div class={rail}>{cv.education.map((entry) => <CvEntry entry={entry} />)}</div>

		<h2 class={sectionTitle}>Skills</h2>
		<dl class="grid grid-cols-[9rem_1fr] gap-x-4 gap-y-1">
			{cv.skills.map((row) => [<dt class="font-semibold text-strong">{row.label}</dt>, <dd>{row.value}</dd>])}
		</dl>

		<h2 class={sectionTitle}>Languages</h2>
		<dl class="grid grid-cols-[9rem_1fr] gap-x-4 gap-y-1">
			{cv.languages.map((row) => [<dt class="font-semibold text-strong">{row.label}</dt>, <dd>{row.value}</dd>])}
		</dl>
	</div>
</BaseLayout>
