---
// Shown for any address that doesn't exist. GitHub Pages serves it automatically.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
	<div data-page class="page py-16">
		<h1 class="text-3xl font-semibold text-strong">Page not found</h1>
		<p class="mt-3 text-muted">Error 404: that page doesn't exist, or it has moved.</p>
		<p class="mt-6 font-mono text-sm"><a href="/">&lt;- Go to the home page</a></p>
	</div>
</BaseLayout>
