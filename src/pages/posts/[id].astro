---
// One page per post: /posts/<folder>/
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getPublished } from '../../lib/collections';

export async function getStaticPaths() {
	const posts = await getPublished('posts');
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
---

<EntryLayout
	collection="posts"
	title={post.data.title}
	date={post.data.date}
	tags={post.data.tags}
	cover={post.data.cover}
	headings={headings}
	readingMinutes={remarkPluginFrontmatter.readingMinutes}
	description={remarkPluginFrontmatter.excerpt}
>
	<Content />
</EntryLayout>
