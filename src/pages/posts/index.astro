---
// The posts page: /posts/ — every post, newest first, grouped by year, with a tag filter.
import { render } from 'astro:content';
import PictureViewer from '../../components/PictureViewer.astro';
import PostRow from '../../components/PostRow.astro';
import TagFilter from '../../components/TagFilter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/collections';
import { formatDate } from '../../lib/dates';
import { stripItems } from '../../lib/images';
import { countTags } from '../../lib/tag-filter';

const posts = await Promise.all(
	(await getPublished('posts')).map(async (post) => {
		const { remarkPluginFrontmatter: meta } = await render(post);
		return { post, excerpt: meta.excerpt as string, readingMinutes: meta.readingMinutes as number, media: await stripItems(post, meta.media) };
	}),
);

const years = Map.groupBy(posts, ({ post }) => formatDate(post.data.date, 'year'));
---

<BaseLayout title="Posts" current="posts">
	<div data-page class="page py-8">
		<h1 class="text-3xl font-semibold text-strong">Posts</h1>
		{posts.length === 0 && <p class="mt-4 text-muted">No posts yet.</p>}
		{posts.length > 0 && <TagFilter tags={countTags(posts.map(({ post }) => post.data))} />}
		{
			[...years].map(([year, entries]) => (
				<section data-filter-group>
					<h2 class="mt-8 mb-1 text-xl font-semibold text-strong">{year}</h2>
					{entries.map(({ post, excerpt, readingMinutes, media }) => (
						<PostRow
							id={post.id}
							title={post.data.title}
							date={post.data.date}
							readingMinutes={readingMinutes}
							tags={post.data.tags}
							excerpt={excerpt}
							media={media}
						/>
					))}
				</section>
			))
		}
	</div>
	<PictureViewer />
</BaseLayout>
