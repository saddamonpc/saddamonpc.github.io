---
// The page for one post or project: fading header image, title, meta line, table of contents, text.
import type { ImageMetadata, MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import TableOfContents from '../components/TableOfContents.astro';
import TagPills from '../components/TagPills.astro';
import type { CollectionName } from '../lib/content';
import { formatDate, readingTime } from '../lib/dates';
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';

interface Props {
	collection: CollectionName;
	title: string;
	date: Date;
	updated?: Date;
	tags: string[];
	cover?: ImageMetadata;
	headings: MarkdownHeading[];
	readingMinutes: number;
	description: string;
	facts?: { category?: string; tools?: string[]; timeframe?: string };
}

const { collection, title, date, updated, tags, cover, headings, readingMinutes, description, facts = {} } = Astro.props;
// "last updated" only when it's a later day than created (the templates fill in both with today's date).
const lastUpdated = updated && formatDate(updated, 'long') !== formatDate(date, 'long') ? formatDate(updated, 'long') : null;

// Project facts strip (category, tools, timeframe). Only the ones that are filled in are shown.
const factRows = [
	{ label: 'category', value: facts.category },
	{ label: 'tools', value: facts.tools?.join(', ') },
	{ label: 'timeframe', value: facts.timeframe },
].filter((row) => row.value);
---

<BaseLayout title={title} description={description} image={cover} current={collection}>
	<article>
		{
			cover && (
				<div class="hero" data-hero>
					<Image src={cover} alt="" width={1600} class="h-60 w-full object-cover sm:h-72" loading="eager" />
				</div>
			)
		}
		<div data-page class="page lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-x-12">
			<header class:list={['lg:col-start-1', cover ? 'relative -mt-12' : 'pt-10']}>
				<h1 class="mb-2 text-3xl leading-tight font-semibold text-strong sm:text-4xl">{title}</h1>
				<div data-entry-meta class="text-sm text-muted">
					<p>
						Created on {formatDate(date, 'long')}{lastUpdated && <>, last updated on {lastUpdated}</>}.
					</p>
					<p>{readingTime(readingMinutes)}</p>
					<div class="mt-2"><TagPills tags={tags} collection={collection} /></div>
				</div>
				{
					factRows.length > 0 && (
						<dl data-facts class="mt-4 flex flex-wrap gap-x-6 gap-y-1 border-y border-dashed border-line py-2 text-sm text-muted">
							{factRows.map((row) => (
								<div class="flex gap-2">
									<dt class="font-semibold text-fg">{row.label}</dt>
									<dd>{row.value}</dd>
								</div>
							))}
						</dl>
					)
				}
			</header>
			<aside class="mt-6 lg:sticky lg:top-6 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-10 lg:self-start">
				<TableOfContents headings={headings} />
			</aside>
			<div class="prose mt-8 max-w-none lg:col-start-1">
				<slot />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	/* The header picture fades out into the page at the bottom. */
	.hero {
		mask-image: linear-gradient(to bottom, #000 40%, transparent 100%);
	}
</style>
