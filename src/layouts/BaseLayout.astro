---
// The frame every page sits in: <head>, skip link, navbar, main content, footer.
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { type NavKey, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	current?: NavKey;
}

const { title, description = SITE_DESCRIPTION, image, current } = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<html lang="en" class="no-js">
	<head>
		<!-- Lets the CSS know JavaScript is on, so the phone menu can collapse. Without JS, links stay visible. -->
		<script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
		<BaseHead title={fullTitle} description={description} image={image} />
	</head>
	<body>
		<a href="#main" class="skip-link">skip to content</a>
		<Header current={current} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
